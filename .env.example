# Server
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=ayphr
REDIS_URL=redis://redis:6379

# Listener ports
TCP_PORT=7232
API_PORT=7233
METRICS_PORT=7234

# CORS
CORS_ALLOWED_ORIGINS=https://ayphr.com,https://www.ayphr.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Maps Stripe price IDs to subscription tiers and billing intervals (lite, plus, ultra).
# Format: price_123:lite:month,price_456:lite:year,price_789:plus:month
# The interval segment is optional and defaults to month.
STRIPE_PRICE_TIERS=

# Object storage (Google Cloud Storage)
# Name of the bucket used for uploaded files (e.g. profile pictures).
GCS_BUCKET=
# Optional: GCP project that owns the bucket. Inferred from credentials when omitted.
GCS_PROJECT_ID=
# Optional: CDN / custom domain for public object URLs (e.g. https://cdn.ayphr.com).
GCS_PUBLIC_BASE_URL=
# Optional: absolute base URL of this API used to build links to proxied objects.
# Defaults to a relative path which the client resolves against its API base URL.
API_PUBLIC_BASE_URL=
# Credentials are discovered via GOOGLE_APPLICATION_CREDENTIALS (path to a service
# account JSON key), Workload Identity, or standard GCP application default
# credentials. Set GOOGLE_APPLICATION_CREDENTIALS when running outside GCP.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-key.json

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus
PROMETHEUS_PASSWORD=change-me
