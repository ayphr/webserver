# Client (Vite)
# Optional override for the API base URL used by the web app.
# Omit this line to use http://localhost:7233 in development and
# https://api.ayphr.com in production; an empty value targets same-origin.
VITE_API_BASE_URL=

# Server
NODE_ENV=development
# Pino levels: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=debug
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=ayphr
MONGO_MAX_POOL_SIZE=100

REDIS_URL=redis://redis:6379

# Public URL of the web client (no trailing slash). Used in invite links,
# subscription return URLs, and emailed logo links. Set this to your public
# HTTPS origin in production.
CLIENT_URL=http://localhost:5173

# Listener ports
API_PORT=7233
METRICS_PORT=7234

# Set to true only when the server runs behind a trusted reverse proxy, so
# X-Forwarded-For is used for client IPs (rate limiting).
TRUST_PROXY=false

# Device pairing codes
# How long a generated device pairing code stays valid, in minutes.
PAIRING_CODE_TTL_MINUTES=5

# CORS
CORS_ALLOWED_ORIGINS=https://ayphr.com,https://www.ayphr.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Free trial length for new paid subscriptions, in days.
STRIPE_TRIAL_DAYS=7
# Maps Stripe price IDs to subscription tiers and billing intervals.
# Tiers: lite, plus, ultra, team-lite, team-plus, team-ultra.
# Intervals: month, year (optional; defaults to month).
# Examples:
#   price_lite_month:lite:month,price_lite_year:lite:year
#   price_plus_month:plus:month,price_team_plus_month:team-plus:month
# Format: price_id:tier[:interval],price_id:tier[:interval],...
STRIPE_PRICE_TIERS=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

GRAFANA_ROOT_URL=https://your-grafana.example.com

# Grafana alert notifications (optional).
ALERT_WEBHOOK_URL=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ayphr <noreply@ayphr.com>

# Web Push (VAPID)
# Generate a keypair with: cd server && npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address or an https:// URL you control.
# All three values are required; /api/notifications/push/public-key returns
# null until they are set. VAPID_PRIVATE_KEY must never be exposed to the client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ayphr.com

# Email verification codes
# How long an emailed verification code stays valid, in minutes.
EMAIL_CODE_TTL_MINUTES=10

# Prometheus
# Set this to the password whose bcrypt hash is committed in
# monitoring/prometheus/web.config.yml. Keep the real value in your private .env.
PROMETHEUS_PASSWORD=change-me
