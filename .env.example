# Server
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=ayphr
MONGO_MAX_POOL_SIZE=100

REDIS_URL=redis://redis:6379

# Listener ports
API_PORT=7233
METRICS_PORT=7234

# Set to true only when the server runs behind a trusted reverse proxy, so
# X-Forwarded-For is used for client IPs (rate limiting).
TRUST_PROXY=false

# Device uploads
# How long a generated device claim token stays valid, in minutes.
DEVICE_TOKEN_TTL_MINUTES=60

# CORS
CORS_ALLOWED_ORIGINS=https://ayphr.com,https://www.ayphr.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Maps Stripe price IDs to subscription tiers and billing intervals (lite, plus, ultra).
# Format: price_123:lite:month,price_456:lite:year,price_789:plus:month
# The interval segment is optional and defaults to month.
STRIPE_PRICE_TIERS=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Grafana alert notifications (optional).
ALERT_WEBHOOK_URL=

# Prometheus
# Set this to the password whose bcrypt hash is committed in
# monitoring/prometheus/web.config.yml. Keep the real value in your private .env.
PROMETHEUS_PASSWORD=change-me
