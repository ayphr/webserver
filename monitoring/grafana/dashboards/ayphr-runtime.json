{
  "annotations": {
    "list": []
  },
  "description": "Process health exported by the Prometheus default metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "ayphr"
      ],
      "targetBlank": false,
      "title": "Ayphr dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU: user vs system",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ayphr_process_cpu_user_seconds_total[$__rate_interval])",
          "legendFormat": "user"
        },
        {
          "refId": "B",
          "expr": "rate(ayphr_process_cpu_system_seconds_total[$__rate_interval])",
          "legendFormat": "system"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ayphr_process_resident_memory_bytes",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "ayphr_nodejs_heap_size_used_bytes",
          "legendFormat": "heap used"
        },
        {
          "refId": "C",
          "expr": "ayphr_nodejs_heap_size_total_bytes",
          "legendFormat": "heap total"
        },
        {
          "refId": "D",
          "expr": "ayphr_nodejs_external_memory_bytes",
          "legendFormat": "external"
        },
        {
          "refId": "E",
          "expr": "ayphr_process_virtual_memory_bytes",
          "legendFormat": "virtual"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Event loop lag",
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "min": 0,
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ayphr_nodejs_eventloop_lag_p50_seconds",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "ayphr_nodejs_eventloop_lag_p90_seconds",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "ayphr_nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "expr": "ayphr_nodejs_eventloop_lag_max_seconds",
          "legendFormat": "max"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "description": "How late the event loop runs its timers. p99 is the worst 1% of delays and is the one to watch."
    },
    {
      "type": "heatmap",
      "title": "GC duration by kind",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "calculation": {
          "xBuckets": {
            "mode": "size",
            "value": "10s"
          },
          "yBuckets": {
            "mode": "count",
            "value": 20
          }
        },
        "cellGap": 2,
        "cellValues": {
          "unit": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Viridis",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "showColorScale": false,
          "yHistogram": true
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "reverse": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ayphr_nodejs_gc_duration_seconds_bucket[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Time spent collecting garbage, grouped by kind and bucket."
    },
    {
      "type": "timeseries",
      "title": "File descriptors",
      "fieldConfig": {
        "defaults": {
          "min": 0,
