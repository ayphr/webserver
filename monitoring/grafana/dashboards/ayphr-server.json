{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests / second",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(ayphr_http_requests_total[5m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "type": "stat",
      "title": "Data points / second",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(ayphr_telemetry_records_persisted_total[5m]))", "legendFormat": "points/s" }
      ]
    },
    {
      "type": "stat",
      "title": "Active devices",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "ayphr_active_devices", "legendFormat": "devices" }
      ]
    },
    {
      "type": "stat",
      "title": "Requests in flight",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "ayphr_http_requests_in_flight", "legendFormat": "in flight" }
      ]
    },
    {
      "type": "stat",
      "title": "5xx / second",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(ayphr_http_requests_total{status=~\"5..\"}[5m])) or vector(0)", "legendFormat": "5xx/s" }
      ]
    },
    {
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP latency percentiles",
      "description": "Request duration quantiles computed from ayphr_http_request_duration_seconds across all routes.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "axisSoftMin": 0, "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ayphr_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.75, sum(rate(ayphr_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p75" },
        { "expr": "histogram_quantile(0.90, sum(rate(ayphr_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, sum(rate(ayphr_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(ayphr_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" },
        { "expr": "sum(rate(ayphr_http_request_duration_seconds_sum[5m])) / sum(rate(ayphr_http_request_duration_seconds_count[5m]))", "legendFormat": "avg" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(rate(ayphr_http_requests_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (route, le) (rate(ayphr_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Busiest routes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "topk(5, sum by (route) (rate(ayphr_http_requests_total[5m])))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "type": "row",
      "title": "Devices / telemetry",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Data points accepted / second",
      "description": "Data points accepted from authenticated device uploads before persistence.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "sum(rate(ayphr_telemetry_records_accepted_total[5m]))", "legendFormat": "accepted/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Data points persisted / second",
      "description": "Data points written to the database. Uploads replace existing values for the same device and second.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "sum(rate(ayphr_telemetry_records_persisted_total[5m]))", "legendFormat": "persisted/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload batch size percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "axisSoftMin": 0, "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ayphr_telemetry_upload_batch_size_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(ayphr_telemetry_upload_batch_size_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(ayphr_telemetry_upload_batch_size_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload duration percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "axisSoftMin": 0, "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ayphr_telemetry_upload_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(ayphr_telemetry_upload_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(ayphr_telemetry_upload_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload errors / second",
      "description": "Authenticated device uploads that failed to persist.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(rate(ayphr_telemetry_upload_errors_total[5m])) or vector(0)", "legendFormat": "errors/s" }
      ]
    },
    {
      "type": "row",
      "title": "System",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU usage",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" } },
      "targets": [
        { "expr": "rate(ayphr_process_cpu_user_seconds_total[5m]) + rate(ayphr_process_cpu_system_seconds_total[5m])", "legendFormat": "CPU" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory usage",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "ayphr_process_resident_memory_bytes", "legendFormat": "RSS" },
        { "expr": "ayphr_nodejs_heap_size_used_bytes", "legendFormat": "Heap used" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Event loop lag",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 4, "custom": { "axisSoftMin": 0, "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "ayphr_nodejs_eventloop_lag_p50_seconds", "legendFormat": "p50" },
        { "expr": "ayphr_nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "MongoDB operations",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum(rate(ayphr_mongo_operations_total[5m])) by (operation, collection)", "legendFormat": "{{operation}} {{collection}}" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "ayphr",
    "server"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "ayphr Server",
  "uid": "ayphr-server",
  "version": 4
}
