{
  "annotations": {
    "list": []
  },
  "description": "Traffic, latency and status-code behaviour across every API route.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "ayphr"
      ],
      "targetBlank": false,
      "title": "Ayphr dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "min": 0,
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(ayphr_http_request_duration_seconds_bucket{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum(rate(ayphr_http_request_duration_seconds_bucket{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) by (le))",
          "legendFormat": "p75"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.90, sum(rate(ayphr_http_request_duration_seconds_bucket{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) by (le))",
          "legendFormat": "p90"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(ayphr_http_request_duration_seconds_bucket{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(rate(ayphr_http_request_duration_seconds_bucket{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        },
        {
          "refId": "F",
          "expr": "sum(rate(ayphr_http_request_duration_seconds_sum{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) / clamp_min(sum(rate(ayphr_http_request_duration_seconds_count{method=~\"$method\", route=~\"$route\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "avg"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "Response time percentiles. p50 is the median and p99 is the slowest 1%. The average is shown for comparison but hides slow requests."
    },
    {
      "type": "heatmap",
      "title": "Latency distribution",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "calculation": {
          "xBuckets": {
            "mode": "size",
            "value": "10s"
          },
          "yBuckets": {
            "mode": "count",
            "value": 20
          }
        },
        "cellGap": 2,
        "cellValues": {
          "unit": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "showColorScale": false,
          "yHistogram": true
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "reverse": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ayphr_http_request_duration_seconds_bucket{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "description": "Requests grouped by how long they took. Brighter cells hold more requests in that time bucket."
    },
    {
      "type": "heatmap",
      "title": "Response size distribution",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "hideFrom": {
