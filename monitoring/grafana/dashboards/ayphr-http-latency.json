      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ayphr_http_response_size_bytes_bucket{method=~\"$method\", route=~\"$route\"}[$__rate_interval])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "description": "Responses grouped by payload size."
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by route",
