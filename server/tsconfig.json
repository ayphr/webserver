{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Shared contract package lives outside this directory. The alias keeps
    // imports depth-independent, so the same specifier resolves identically
    // whether the server runs from the repo (server/ -> ../common) or from its
    // container layout (/app -> /common).
    "baseUrl": ".",
    "paths": {
      "@common": ["../common/index.ts"],
      "@common/*": ["../common/*"]
    }
  }
}
